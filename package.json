{
  "name": "article-publisher-demo",
  "version": "1.0.0",
  "description": "Self-contained PoC for an SEO article publishing pipeline using Temporal",
  "private": true,
  "main": "dist/src/server/main.js",
  "scripts": {
    "build": "tsc",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPatterns=integration --runInBand",
    "test": "npm run test:unit && npm run test:integration",
    "dev": "node dist/src/server/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/common": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.11.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.3"
  }
}
